<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Stationnement.Prototype.App"
             RequestedThemeVariant="Light">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="46" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="FontSize" Value="16" />
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="18,10" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#0E7C66" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Button.primary:pointerover">
      <Setter Property="Background" Value="#0B6654" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#0F3D4C" />
      <Setter Property="BorderBrush" Value="#C5D0D8" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.secondary:pointerover">
      <Setter Property="Background" Value="#F4F7F8" />
    </Style>
    <Style Selector="Button.danger">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#9F1239" />
      <Setter Property="BorderBrush" Value="#FECDD3" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.quiet">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#0F3D4C" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="40" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </Application.Styles>
</Application>
